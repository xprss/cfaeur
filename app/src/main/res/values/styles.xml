<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#132D2A</item>
        <item name="android:navigationBarColor">#132D2A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#266458</item>
        <item name="android:windowBackground">#F3F7F3</item>
    </style>
    <style name="WidgetKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/widget_key_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetKey.Action" parent="WidgetKey">
        <item name="android:background">@drawable/widget_action_background</item>
        <item name="android:textColor">#132D2A</item>
    </style>
</resources>
